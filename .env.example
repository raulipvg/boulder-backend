# Variables utilizadas por docker-compose para el backend
# Reemplaza valores sensibles antes de desplegar en otros entornos

ASPNETCORE_ENVIRONMENT=Development
# Nombre del contenedor/host de la base de datos desplegada en Dokploy
DB_HOST=erp-boulder-db
DB_PORT=5432
DB_NAME=boulder_db
DB_USER=boulder_kali_db
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

ConnectionStrings__DefaultConnection=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

Jwt__Key=CHANGE_ME_JWT_KEY_MIN_32_CHARS
Jwt__Issuer=Boulder-API
Jwt__Audience=Boulder-Client

# Nombre de la red externa compartida con la base de datos (debe existir)
EXTERNAL_NETWORK_NAME=boulder-red-interna-kali
